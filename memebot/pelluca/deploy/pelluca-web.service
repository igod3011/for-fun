[Unit]
Description=Pelluca website (pelluca.com, read-only checks)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pelluca
WorkingDirectory=/home/pelluca/app
EnvironmentFile=/home/pelluca/pelluca.env
ExecStart=/usr/bin/python3 -m memebot.pelluca.web
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
